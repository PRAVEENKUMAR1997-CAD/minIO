# MinIO S3 Platform - Environment Configuration
# ==============================================
# Copy this file to .env and configure all values.
# NEVER commit .env to version control.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#   ./scripts/start.sh

# ==================================================
# ROOT/ADMIN CREDENTIALS (REQUIRED)
# ==================================================
# These credentials provide full administrative access.
# Use strong, unique values. Minimum 8 characters recommended.
# 
# SECURITY: These credentials should ONLY be used for:
#   - Initial setup
#   - Administrative tasks
#   - Emergency access
#
# Applications should NEVER use root credentials.

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_MIN_12_CHARS

# ==================================================
# DEVELOPER USER CREDENTIALS
# ==================================================
# These credentials are for the developer/application user.
# This user has limited permissions (bucket access only).
#
# Used by bootstrap.sh to create the developer identity.

MINIO_DEVELOPER_USER=developer
MINIO_DEVELOPER_PASSWORD=CHANGE_THIS_DEVELOPER_PASSWORD

# ==================================================
# BUCKET CONFIGURATION
# ==================================================
# Default bucket created during bootstrap.
# The developer user will have access to this bucket.

MINIO_DEFAULT_BUCKET=developer-data

# ==================================================
# NETWORK CONFIGURATION
# ==================================================
# Port bindings for MinIO services.
#
# MINIO_API_PORT: S3-compatible API endpoint
# MINIO_CONSOLE_PORT: Web console for administration

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# MINIO_BIND_ADDRESS: Network interface to bind to
#
# SECURITY CONSIDERATIONS:
#   127.0.0.1     - Localhost only (most secure, default)
#   0.0.0.0       - All interfaces (required for remote access)
#   <specific-ip> - Specific interface only
#
# WARNING: Binding to 0.0.0.0 exposes MinIO to the network.
# Only use 0.0.0.0 when:
#   - Behind a firewall
#   - With proper network security
#   - For server deployments requiring remote access
#
# For production remote access, consider using a reverse proxy with TLS.

MINIO_BIND_ADDRESS=127.0.0.1

# ==================================================
# REGION CONFIGURATION
# ==================================================
# S3 region identifier. Must match client configuration.
# Default: us-east-1 (AWS default region)

MINIO_REGION=us-east-1

# ==================================================
# EXTERNAL URL CONFIGURATION (OPTIONAL)
# ==================================================
# Configure these when running behind a reverse proxy.
#
# MINIO_SERVER_URL: External URL for S3 API access
#   - Used for pre-signed URLs
#   - Must be reachable by clients
#   - Example: https://s3.example.com
#
# MINIO_BROWSER_REDIRECT_URL: External URL for Console access
#   - Used for browser redirects
#   - Example: https://minio-console.example.com
#
# Leave empty for local/direct access.

MINIO_SERVER_URL=
MINIO_BROWSER_REDIRECT_URL=

# ==================================================
# LOGGING CONFIGURATION (OPTIONAL)
# ==================================================
# Uncomment to enable additional logging.
# MINIO_LOGGER_WEBHOOK_ENABLE=on
# MINIO_LOGGER_WEBHOOK_ENDPOINT=http://logger:8080/logs

# ==================================================
# EXTERNAL S3 BROWSER (OPTIONAL)
# ==================================================
# The External S3 Browser provides read-only access to AWS S3 buckets
# through a web interface. Users authenticate with MinIO credentials,
# but browse actual AWS S3 data (not copied to MinIO).
#
# IMPORTANT: AWS credentials are stored server-side only.
# Users never see or receive AWS credentials.
#
# To enable, set S3_BROWSER_ENABLED=true and configure the options below.

S3_BROWSER_ENABLED=false
S3_BROWSER_PORT=8080

# AWS credentials for S3 access (read-only IAM user recommended)
# These are NEVER exposed to users or the browser.
# Alternatively, use an EC2 instance role (leave these empty).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# Comma-separated list of AWS S3 bucket names users can browse.
# Only these buckets will be visible. Example: bucket1,bucket2,bucket3
APPROVED_S3_BUCKETS=

# Flask application secret key for session signing.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
S3_BROWSER_SECRET_KEY=CHANGE_THIS_GENERATE_A_RANDOM_SECRET

# MinIO bucket used to validate user credentials during login.
# Users must have read access to this bucket to authenticate.
# Typically set to the default MinIO bucket (developer-data).
S3_BROWSER_AUTH_BUCKET=developer-data

# ==================================================
# NOTES
# ==================================================
# 1. All passwords should be strong and unique
# 2. Never use default/example passwords in production
# 3. Rotate credentials periodically
# 4. Use a secrets manager for production deployments
# 5. This file should have restricted permissions (chmod 600)
