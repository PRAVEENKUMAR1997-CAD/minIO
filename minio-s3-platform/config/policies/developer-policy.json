{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowBucketLevelActions",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": [
        "arn:aws:s3:::${BUCKET_NAME}"
      ],
      "Comment": "Allows listing bucket contents and getting bucket location. Required for most S3 operations."
    },
    {
      "Sid": "AllowObjectLevelActions",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:GetObjectVersion",
        "s3:DeleteObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::${BUCKET_NAME}/*"
      ],
      "Comment": "Allows standard CRUD operations on objects within the bucket."
    },
    {
      "Sid": "AllowMultipartUpload",
      "Effect": "Allow",
      "Action": [
        "s3:ListMultipartUploadParts",
        "s3:AbortMultipartUpload"
      ],
      "Resource": [
        "arn:aws:s3:::${BUCKET_NAME}/*"
      ],
      "Comment": "Allows multipart upload operations for large file uploads."
    }
  ]
}
